# ByKatriel · ajustes para servidores Apache (Hostinger, SiteGround, cPanel...).
# En servidores que no son Apache (Netlify, Vercel, GitHub Pages) este archivo se ignora.

AddDefaultCharset UTF-8
AddType application/manifest+json .webmanifest

# Compresión de texto
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain application/json application/manifest+json image/svg+xml text/xml application/xml
</IfModule>

# Caché del navegador: la página se revisa siempre; imágenes, vídeo y fuentes se guardan un mes
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
</IfModule>
